# Copy to .env.local. Nothing here is required: without keys the planner uses
# link-only booking buttons and clearly labelled "Sample prices".
# Server-only keys below are never exposed to the browser.

# Flights: free token from https://www.travelpayouts.com (Developers > API). See docs/PRICES.md
TRAVELPAYOUTS_TOKEN=

# Activities: Viator Partner API, Basic Access (self-service). See docs/PRICES.md
VIATOR_API_KEY=

# Optional affiliate IDs. These are public (they end up in outbound URLs).
NEXT_PUBLIC_AFFILIATE_BOOKING_AID=
NEXT_PUBLIC_AFFILIATE_SKYSCANNER_ID=
NEXT_PUBLIC_AFFILIATE_VIATOR_PID=
NEXT_PUBLIC_AFFILIATE_GETYOURGUIDE_PARTNER_ID=
NEXT_PUBLIC_AFFILIATE_KLOOK_AID=
NEXT_PUBLIC_AFFILIATE_12GO_ID=
