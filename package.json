{
  "name": "sekai-ai-itinerary-planner",
  "version": "1.0.0",
  "description": "A travel itinerary planner built from 20 hand-curated destinations — real landmarks, restaurants, and neighborhoods, with a deterministic engine that builds geographically sensible day-by-day plans. No invented venues, no AI-generated data.",
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "travel",
    "itinerary-planner",
    "trip-planner"
  ],
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "validate:offline": "tsx scripts/validate-data.ts --skip-urls",
    "enrich": "tsx scripts/enrich-geo.ts",
    "parse-costs": "tsx scripts/parse-costs.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "puppeteer-core": "^25.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
